# Shared hosting (Apache / LiteSpeed). Vercel ignores this file.
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Always HTTPS, and send www to the bare domain
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Never serve code folders, config, docs or dotfiles directly
RewriteRule ^(includes|api|\.git)(/|$) - [F,L]
RewriteRule ^(config|config\.php|README\.md|vercel\.json|install\.lock|\.gitignore)$ - [F,L]
RewriteRule (^|/)\. - [F,L]

# Clean addresses: old links ending in .php move to the address without it (page visits only;
# form posts and webhooks keep working at the .php address).
RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/+[^\s?]+\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !(^|/)(flw_webhook|np_webhook|cron|sw|manifest)\.php$ [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# ...and /crypto is served by crypto.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
