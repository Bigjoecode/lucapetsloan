{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60,
      "excludeFiles": "{uploads/**,.git/**,README.md}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "status": 308,
      "headers": {
        "Location": "https://lucapetsloan.com/$1",
        "cache-control": "public, max-age=3600"
      }
    }
  ]
}
